# Merge these names into backend/.env manually. This file contains no secrets.
# Existing SUPABASE_URL and JWT_SECRET remain shared. Business needs a server-only
# service_role/secret key; do not put it in VITE_* or EXPO_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# Development: open the frontend at this exact origin (Vite proxies /api/business).
BUSINESS_WEB_ORIGINS=http://localhost:5173
BUSINESS_WEB_URL=http://localhost:5173

# Required for invitation delivery; no console tokens or public test fallback.
RESEND_API_KEY=
BUSINESS_EMAIL_FROM=

# Existing routing credentials. Choose a configured provider; keep keys server-side.
GOOGLE_MAPS_API_KEY=
OPENROUTESERVICE_API_KEY=

# Keep disabled: this is the OLD cross-company panel, never a company admin role.
LEGACY_BUSINESS_ADMIN_ENABLED=false
# If explicitly authorized for an isolated maintenance environment only:
# LEGACY_BUSINESS_ADMIN_EMAIL=
# LEGACY_BUSINESS_ADMIN_PASSWORD_HASH=
