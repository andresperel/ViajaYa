# Copy this file to .env and replace the placeholders with this project's values.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# For web on the development computer. On a physical phone, use the computer's
# LAN IP address instead, for example http://192.168.1.10:3000.
EXPO_PUBLIC_API_URL=http://localhost:3000
